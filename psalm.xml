<?xml version="1.0"?>
<psalm
    errorLevel="8"
    resolveFromConfigFile="true"
    findUnusedCode="false"
    findUnusedBaselineEntry="false"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
>
    <!--
        Level 8 with taint analysis, matching the other ramon/* extensions. The
        point here is not general type strictness but the source-to-sink flows
        Semgrep's pattern rules cannot see: a request value reaching raw SQL, a
        filename reaching the filesystem, unescaped input reaching rendered output.
        Only the workflow (.github/workflows/psalm.yml) consumes this file; psalm
        is installed there ad hoc and is not a require-dev dependency.
    -->
    <projectFiles>
        <directory name="src" />
        <directory name="migrations" />
        <file name="extend.php" />
        <ignoreFiles>
            <directory name="vendor" />
        </ignoreFiles>
    </projectFiles>
</psalm>
